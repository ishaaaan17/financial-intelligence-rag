# Copy this file to .env and fill in real values. Never commit .env itself.

# --- LLM (Groq) ---
GROQ_API_KEY=gsk_your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.0

# DEC-014: bounded timeout + retry budget for Groq calls (see CONSTRAINTS.md section 11).
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=3

# --- Vector store (Qdrant Cloud) ---
QDRANT_URL=https://your-cluster-url.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
COLLECTION_NAME=sec_filings

# --- Local embeddings ---
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# --- CORS (DEC-013) ---
# Comma-separated list of allowed frontend origins.
# Defaults cover local Streamlit + Swagger dev origins; override for any non-local deployment.
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:8000,http://127.0.0.1:8000